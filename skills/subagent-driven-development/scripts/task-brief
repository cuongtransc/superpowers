#!/usr/bin/env bash
# Extract one task's brief from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# The brief is the plan's "Global Constraints" section (when the plan has
# one) followed by the task's full text. Every task's requirements
# implicitly include the global constraints, and the reviewer grades
# against them — so the implementer must see them in the same file.
#
# A task ends at the next heading of the same or a shallower level, whether
# or not it is another Task: a trailing "## Self-Review" or "## Notes"
# section after the last task never leaks into that task's brief. Headings
# inside fenced code blocks are ignored.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  # Invoke via bash rather than direct exec: some extractors (Python zipfile)
  # strip Unix exec bits when unpacking marketplace packages.
  dir=$("${BASH:-bash}" "$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

awk -v n="$n" '
  function level(line) { match(line, /^#+/); return RLENGTH }
  # The whole task number after "Task" ("6", "6b", "6.1"), compared as a
  # string: a prefix or regex match would hand Task 6b to a request for 6.
  function task_id(line,   t) {
    t = line
    sub(/^#+[ \t]+Task[ \t]+/, "", t)
    match(t, /^[0-9A-Za-z._-]+/)
    t = substr(t, 1, RLENGTH)
    sub(/\.+$/, "", t)
    return t
  }
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+/ {
    lvl = level($0)
    if (intask && lvl <= tasklvl) intask = 0
    if (incons && lvl <= conslvl) incons = 0
    # Any Task heading ends the constraints block, even a deeper one: a
    # hand-written plan may go straight from "## Global Constraints" to
    # "### Task 1" with no rule or wrapper heading between them.
    if ($0 ~ /^#+[ \t]+Task[ \t]+[0-9]+/) incons = 0
    if ($0 ~ /^#+[ \t]+Task[ \t]+[0-9]/ && task_id($0) == n) { intask = 1; tasklvl = lvl }
    else if ($0 ~ /^#+[ \t]+Global Constraints/) { incons = 1; conslvl = lvl }
  }
  # A bare "---" rule closes the constraints block (the plan template puts
  # one right after it); it carries nothing the implementer needs.
  incons && /^---[ \t]*$/ { incons = 0; next }
  incons { cons = cons $0 "\n" }
  intask { task = task $0 "\n" }
  END {
    if (task == "") exit 3
    if (cons != "") { printf "%s\n", cons; found_cons = 1 }
    printf "%s", task
    exit (found_cons ? 0 : 4)
  }
' "$plan" > "$out" || rc=$?
rc=${rc:-0}

if [ "$rc" -eq 3 ] || [ ! -s "$out" ]; then
  rm -f "$out"
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

if [ "$rc" -eq 4 ]; then
  echo "note: ${plan} has no 'Global Constraints' section; the brief carries only the task text" >&2
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
